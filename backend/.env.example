DJANGO_SECRET_KEY=replace-with-a-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Provide either ORS_API_KEY (OpenRouteService) or MAPBOX_ACCESS_TOKEN.
# If neither is set, the router automatically falls back to public OSRM routing.
ORS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Custom User-Agent required by Nominatim usage policy
NOMINATIM_USER_AGENT=WeatherAwareTruckRouting/1.0 (contact@example.com)
